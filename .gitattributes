* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.parquet binary
# Distribution manifests hash exact bytes; checkouts must not convert newlines.
src/qwb/bundled/** -text
# Format fixtures are hashed byte for byte (CRLF, GBK and BOM are part of the formats).
tests/fixtures/formats/** -text
# Public audit artifacts have byte-exact SHA256 manifests generated on Windows.
website/public/cases/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
website/public/examples/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
